# Copiez ce fichier en `.env.local` et renseignez les valeurs de votre projet Supabase.
# `.env.local` est ignoré par Git (règle `*.local`) et n'est jamais commité.
#
# Où trouver ces valeurs : tableau de bord Supabase > Project Settings > API.

# URL de l'API du projet Supabase.
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé PUBLIQUE (publishable / anon). Elle est intégrée au bundle envoyé au navigateur :
# c'est normal et sans danger tant que les politiques RLS sont en place.
#
# /!\ N'utilisez JAMAIS une clé `sb_secret_` ou `service_role` ici. Une clé secrète
#     contourne toutes les politiques RLS et donnerait à n'importe quel visiteur un
#     accès total à la base.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre_cle

# Origine publique de l'application déployée. Sert à générer les liens encodés dans
# les QR codes des salles : sans cette variable, les affiches imprimées pointeraient
# vers http://localhost:5173 et seraient inutilisables.
VITE_PUBLIC_APP_URL=https://helpdesk.cesi.fr
