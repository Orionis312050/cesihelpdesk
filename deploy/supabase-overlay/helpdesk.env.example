

############
# CESI Helpdesk — bloc ajouté au .env amont par deploy/scripts/installer-supabase.sh
#
# Les variables Supabase elles-mêmes (URL publiques, DISABLE_SIGNUP, clés…) sont
# réglées par le script directement dans les lignes amont ci-dessus.
############

# Dépôt de l'application sur la VM. La fonction « notifications » est montée depuis
# ${HELPDESK_REPO}/supabase/functions : pas de copie à maintenir.
HELPDESK_REPO=/opt/cesihelpdesk

# Secret partagé entre la base (public.configuration.secret_notifications) et la
# fonction Edge. Sans lui, n'importe qui pourrait déclencher des envois d'e-mails.
# Généré par installer-supabase.sh (openssl rand -hex 32).
FUNCTION_SECRET=

# Transport des e-mails : `console` (composés et journalisés dans email_log, non
# envoyés) ou `smtp` (envoi réel via SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS /
# SMTP_ADMIN_EMAIL définis plus haut, partagés avec Supabase Auth).
MAIL_TRANSPORT=console

# Destinataires, séparés par des virgules.
# Alerte immédiate « risque d'accident » :
ALERT_RECIPIENTS=securite@cesi.fr,services-generaux@cesi.fr
# Récapitulatif du vendredi matin :
WEEKLY_RECIPIENTS=services-generaux@cesi.fr

# Adresse publique de l'application, pour les liens contenus dans les e-mails.
PUBLIC_APP_URL=https://helpdesk.cesilarochelle.fr
