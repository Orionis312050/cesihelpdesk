# Secrets de la fonction « notifications ».
#
# En local : copiez ce fichier en `supabase/functions/.env` (ignoré par Git),
# puis lancez `npm run functions:serve`.
#
# En production : ne déployez PAS ce fichier. Utilisez
#   supabase secrets set MAIL_TRANSPORT=smtp SMTP_HOST=... SMTP_USER=...
# Voir docs/04-exploitation.md § Faire tourner les secrets SMTP.

# Secret partagé avec la base (table `public.configuration`, clé
# `secret_notifications`). Empêche que la fonction soit déclenchée depuis
# Internet. Générez-en un avec : openssl rand -hex 32
FUNCTION_SECRET=changez-moi-par-une-chaine-aleatoire

# Transport : `console` (journalise sans envoyer) ou `smtp` (envoi réel).
# Laisser sur `console` tant que le service informatique n'a pas fourni les
# identifiants du relais : toute la chaîne reste testable.
MAIL_TRANSPORT=console

# Relais SMTP de l'établissement (requis uniquement si MAIL_TRANSPORT=smtp).
# Port 587 = STARTTLS, port 465 = TLS direct.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=helpdesk@cesi.fr

# Destinataires, séparés par des virgules.
# Alerte immédiate « risque d'accident ou de blessure » :
ALERT_RECIPIENTS=securite@cesi.fr,services-generaux@cesi.fr
# Récapitulatif du vendredi matin :
WEEKLY_RECIPIENTS=services-generaux@cesi.fr

# Adresse publique de l'application, pour les liens contenus dans les e-mails.
PUBLIC_APP_URL=https://helpdesk.cesilarochelle.fr
