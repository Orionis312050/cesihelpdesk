{
  "entryPoints": ["src"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "theme": "default",
  "readme": "docs/api-accueil.md",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "hideGenerator": false,
  "commentStyle": "jsdoc",
  "tsconfig": "tsconfig.app.json",
  "highlightLanguages": ["typescript", "bash", "sql", "json"]
}
